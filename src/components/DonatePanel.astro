---
import type { Initiative } from '../data/initiatives';
import { site } from '../data/site';
import { tr, useTranslations, type Lang } from '../i18n';

interface Props {
  initiative: Initiative;
  lang: Lang;
}

const { initiative: i, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="donate">
  <h2>{t('donate.title')}</h2>
  <p>{t('donate.sub')}</p>
  {
    i.donateUrl ? (
      <a class="btn btn--primary btn--big" href={i.donateUrl} target="_blank" rel="noopener">
        {t('cta.donate')}
      </a>
    ) : (
      <>
        <p class="note">{t('donate.noLink')}</p>
        <a
          class="btn btn--primary btn--big"
          href={`mailto:${site.email}?subject=${encodeURIComponent(`Donation – ${tr(i.country, 'en')}`)}`}
        >
          {t('cta.email')}
        </a>
      </>
    )
  }
</div>

<style>
  .donate {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  p {
    color: var(--muted);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }
  .note {
    font-size: 1rem;
    margin-bottom: 20px;
  }
</style>
