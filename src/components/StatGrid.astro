---
import type { Stat } from '../data/initiatives/types';
import { tr, type Lang } from '../i18n';

interface Props {
  stats: Stat[];
  lang: Lang;
  variant?: 'card' | 'plain';
}

const { stats, lang, variant = 'card' } = Astro.props;
// Keep rows even: 3 per row for 3/6/9 stats, otherwise up to 4
const cols = stats.length % 3 === 0 ? 3 : Math.min(stats.length, 4);
---

<dl class:list={['stats', `stats--${variant}`]} style={`--cols:${cols}`}>
  {
    stats.map((s) => (
      <div class="stat">
        <dt class="stat-label">{tr(s.label, lang)}</dt>
        <dd class="stat-value">{s.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  dd {
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .stats--card .stat {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 22px 20px;
  }
  .stats--plain .stat {
    padding: 8px 0;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--teal-900);
    font-variant-numeric: tabular-nums;
  }
  :global(.section--dark) .stat-value {
    color: #fff;
  }
  .stat-label {
    hyphens: auto;
    overflow-wrap: break-word;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.4;
  }
  :global(.section--dark) .stat-label {
    color: #b9d3d6;
  }
</style>
