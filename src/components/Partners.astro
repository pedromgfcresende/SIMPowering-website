---
import { Image } from 'astro:assets';
import type { Partner } from '../data/initiatives/types';
import { tr, type Lang } from '../i18n';

interface Props {
  partners: Partner[];
  lang: Lang;
}

const { partners, lang } = Astro.props;
const nameOf = (p: Partner) => (typeof p.name === 'string' ? p.name : tr(p.name, lang));
---

<ul class="partners">
  {
    partners.map((p) => {
      const Tag = p.url ? 'a' : 'div';
      return (
        <li>
          <Tag class="partner" href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener' : undefined}>
            {p.logo ? (
              <Image class="logo" src={p.logo} alt={nameOf(p)} height={56} />
            ) : (
              <span class="wordmark">{nameOf(p)}</span>
            )}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .partners {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }
  li {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }
  .partner {
    display: grid;
    place-items: center;
    height: 120px;
    padding: 20px 24px;
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .logo {
    max-height: 56px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--teal-900);
  }
</style>
