---
import { Image } from 'astro:assets';
import type { Partner } from '../data/initiatives/types';
import { tr, type Lang } from '../i18n';

interface Props {
  partners: Partner[];
  lang: Lang;
}

const { partners, lang } = Astro.props;
const nameOf = (p: Partner) => (typeof p.name === 'string' ? p.name : tr(p.name, lang));
---

<ul class="partners">
  {
    partners.map((p) => {
      const Tag = p.url ? 'a' : 'div';
      return (
        <li>
          <Tag class="partner" href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener' : undefined}>
            <div class="mark">
              {p.logo ? <Image class="logo" src={p.logo} alt={nameOf(p)} height={44} /> : <span class="name-mark">{nameOf(p)}</span>}
            </div>
            <span class="role">{tr(p.role, lang)}</span>
            {p.logo && <h3>{nameOf(p)}</h3>}
            {p.description && <p>{tr(p.description, lang)}</p>}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .partners {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 16px;
  }
  li {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }
  .partner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 26px;
    text-decoration: none;
    color: inherit;
  }
  .mark {
    height: 52px;
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .logo {
    height: 44px;
    width: auto;
    max-width: 190px;
    object-fit: contain;
    object-position: left;
  }
  .name-mark {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--teal-900);
  }
  .role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin: 4px 0 0;
  }
  p {
    margin: 10px 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>
