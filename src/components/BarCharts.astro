---
import type { BarChart } from '../data/initiatives/types';
import { tr, type Lang } from '../i18n';

interface Props {
  charts: BarChart[];
  lang: Lang;
}

const { charts, lang } = Astro.props;
const format = (value: number, unit?: string) => (unit === '€' ? `€${value}` : unit ? `${value}${unit}` : `${value}`);
---

<div class="grid grid--3">
  {
    charts.map((chart) => {
      const max = Math.max(...chart.bars.map((b) => b.value), 1);
      return (
        <figure class="card chart">
          <span class="eyebrow">{tr(chart.tag, lang)}</span>
          <h3>{tr(chart.title, lang)}</h3>
          <ul class="bars">
            {chart.bars.map((b) => (
              <li>
                <span class="bar-label">{tr(b.label, lang)}</span>
                <span class="bar-track">
                  <span class="bar-fill" style={`width:${(b.value / max) * 100}%`} />
                </span>
                <span class="bar-value">{format(b.value, chart.unit)}</span>
              </li>
            ))}
          </ul>
          <figcaption>{tr(chart.caption, lang)}</figcaption>
        </figure>
      );
    })
  }
</div>

<style>
  .chart {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .chart .eyebrow {
    margin-bottom: 6px;
  }
  .bars {
    list-style: none;
    padding: 0;
    margin: 8px 0 18px;
    display: grid;
    gap: 12px;
  }
  .bars li {
    display: grid;
    grid-template-columns: 96px 1fr 48px;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
  }
  .bar-track {
    height: 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 10%, white);
    overflow: hidden;
  }
  .bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
    min-width: 2px;
  }
  .bar-value {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
