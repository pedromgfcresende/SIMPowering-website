---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import InitiativeCard from '../components/InitiativeCard.astro';
import StatGrid from '../components/StatGrid.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Partners from '../components/Partners.astro';
import { home } from '../data/home';
import { initiatives } from '../data/initiatives';
import { localizePath, tr, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [firstLine, secondLine] = tr(home.hero.title, lang).split('\n');
---

<Layout lang={lang} title="SIMpowering" description={tr(home.hero.text, lang)}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">{tr(home.hero.eyebrow, lang)}</div>
        <h1>{firstLine}<br /><em>{secondLine}</em></h1>
        <p class="hero-text">{tr(home.hero.text, lang)}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--big" href="#donate">{t('cta.donate')}</a>
          <a class="btn btn--outline btn--big" href="#initiatives">{t('nav.initiatives')}</a>
        </div>
      </div>
      <div class="hero-art">
        <div class="blob" aria-hidden="true"></div>
        <Image
          src={home.hero.image}
          alt={tr(home.hero.imageAlt, lang)}
          widths={[360, 560, 720]}
          sizes="(max-width: 900px) 70vw, 460px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="initiatives" class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">{t('nav.initiatives')}</div>
        <h2>{tr(home.initiatives.title, lang)}</h2>
        <p>{tr(home.initiatives.text, lang)}</p>
      </div>
      <div class="grid grid--2">
        {initiatives.map((i) => <InitiativeCard initiative={i} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{tr(home.problem.title, lang)}</h2>
        <p>{tr(home.problem.text, lang)}</p>
      </div>
      <div class="grid grid--3">
        {
          home.problem.cards.map((c, n) => (
            <article class="card problem-card">
              <span class="num">0{n + 1}</span>
              <h3>{tr(c.title, lang)}</h3>
              <p class="muted">{tr(c.text, lang)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="approach" class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">{t('nav.approach')}</div>
        <h2>{tr(home.approach.title, lang)}</h2>
        <p>{tr(home.approach.text, lang)}</p>
      </div>
      <ol class="grid grid--3 steps">
        {
          home.approach.steps.map((s, n) => (
            <li class="card step">
              <Image src={s.image} alt={tr(s.alt, lang)} widths={[400, 640]} sizes="(max-width: 900px) 100vw, 360px" />
              <div class="step-body">
                <span class="step-num">{n + 1}</span>
                <h3>{tr(s.title, lang)}</h3>
                <p class="muted">{tr(s.text, lang)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <h2>{tr(home.totals.title, lang)}</h2>
      </div>
      <StatGrid stats={home.totals.stats} lang={lang} variant="plain" />
    </div>
  </section>

  <section id="partners" class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.partners')}</h2>
      </div>
      {
        initiatives
          .filter((i) => i.partners)
          .map((i) => (
            <div class="partner-group">
              <h3 class="group-title">{tr(i.country, lang)}</h3>
              <Partners partners={i.partners!.list} lang={lang} />
            </div>
          ))
      }
    </div>
  </section>

  <section id="donate" class="section section--tint">
    <div class="container donate">
      <div>
        <div class="eyebrow">{t('nav.donate')}</div>
        <h2>{tr(home.donate.title, lang)}</h2>
        <p class="muted">{tr(home.donate.text, lang)}</p>
      </div>
      <ul class="donate-list">
        {
          initiatives.map((i) => (
            <li>
              <a href={localizePath(`/${i.slug}#donate`, lang)}>
                <span>
                  <strong>{tr(i.country, lang)}</strong>
                  <span class="muted">
                    {tr(i.region, lang)} · {i.years}
                  </span>
                </span>
                <span class="btn btn--primary">{t('nav.donate')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container about">
      <div>
        <h2>{tr(home.about.title, lang)}</h2>
        <p>{tr(home.about.text, lang)}</p>
        <div class="btn-row">
          <a class="btn btn--outline" href={localizePath('/team', lang)}>{t('nav.team')}</a>
          <a class="btn btn--outline" href={localizePath('/contact', lang)}>{t('cta.contact')}</a>
        </div>
      </div>
      <div class="follow">
        <h3>{t('contact.follow')}</h3>
        <SocialLinks variant="dark" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(40px, 7vw, 88px) 0 clamp(48px, 7vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  h1 em {
    font-style: italic;
    color: var(--pink-600);
  }
  .hero-text {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 560px;
    margin: 20px 0 30px;
  }
  .hero-art {
    position: relative;
    justify-self: center;
    max-width: 440px;
  }
  .blob {
    position: absolute;
    inset: 12% -6% 0 -6%;
    background: radial-gradient(circle at 30% 30%, var(--mint-100), var(--teal-400) 140%);
    border-radius: 46% 54% 40% 60% / 55% 45% 55% 45%;
    z-index: 0;
  }
  .hero-art img {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 320px;
    }
  }

  .problem-card .num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--pink-600);
    line-height: 1;
    display: block;
    margin-bottom: 14px;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .step {
    padding: 0;
    overflow: hidden;
  }
  .step img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .step-body {
    padding: 24px 26px 26px;
    position: relative;
  }
  .step-num {
    position: absolute;
    top: -26px;
    right: 22px;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--pink-600);
    color: #fff;
    font-weight: 700;
    font-size: 1.3rem;
    border: 4px solid var(--paper);
  }

  .partner-group + .partner-group {
    margin-top: 40px;
  }
  .group-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .donate {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .donate {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  .donate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .donate-list li + li {
    border-top: 1px solid var(--line);
  }
  .donate-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 26px;
    text-decoration: none;
    color: var(--ink);
  }
  .donate-list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--teal-900);
  }
  .donate-list a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .about p {
    font-size: 1.1rem;
    max-width: 680px;
  }
  .follow h3 {
    margin-bottom: 14px;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
