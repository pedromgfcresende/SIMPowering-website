---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import StatGrid from '../components/StatGrid.astro';
import BarCharts from '../components/BarCharts.astro';
import Partners from '../components/Partners.astro';
import DonatePanel from '../components/DonatePanel.astro';
import InitiativeCard from '../components/InitiativeCard.astro';
import { initiatives, type Initiative } from '../data/initiatives';
import { tr, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  initiative: Initiative;
}

const { lang, initiative: i } = Astro.props;
const t = useTranslations(lang);
const others = initiatives.filter((o) => o.slug !== i.slug);
const country = tr(i.country, lang);
---

<Layout lang={lang} title={country} description={tr(i.intro, lang)} donateHref="#donate">
  <div style={`--accent:${i.accent}`}>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">
            {t(`initiative.status.${i.status}`)} · {tr(i.region, lang)} · {i.years}
          </div>
          <h1>{country}</h1>
          <p class="tagline">{tr(i.tagline, lang)}</p>
          <p class="intro">{tr(i.intro, lang)}</p>
          <div class="btn-row">
            <a class="btn btn--primary btn--big" href="#donate">{t('cta.donate')}</a>
            {i.partners && <a class="btn btn--outline btn--big" href="#partners">{t('initiative.partners')}</a>}
          </div>
        </div>
        <div class="hero-media">
          <Image
            src={i.heroImage}
            alt={tr(i.heroAlt, lang)}
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 100vw, 520px"
            loading="eager"
          />
        </div>
      </div>
    </section>

    {
      i.context && (
        <section class="section section--dark">
          <div class="container">
            <div class="section-head">
              <h2>{tr(i.context.title, lang)}</h2>
              <p>{tr(i.context.text, lang)}</p>
            </div>
            <StatGrid stats={i.context.stats} lang={lang} variant="plain" />
            {i.context.source && <p class="source">Source: {i.context.source}</p>}
          </div>
        </section>
      )
    }

    {
      i.impact && (
        <section id="impact" class="section section--tint">
          <div class="container">
            <div class="section-head">
              <h2>{tr(i.impact.title, lang)}</h2>
              <p>{tr(i.impact.text, lang)}</p>
            </div>
            <StatGrid stats={i.impact.stats} lang={lang} />
            {i.impact.charts && (
              <div class="charts">
                <BarCharts charts={i.impact.charts} lang={lang} />
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      i.gallery && i.gallery.length > 0 && (
        <section class="gallery" aria-label="Photos">
          {i.gallery.map((g) => (
            <Image src={g.image} alt={tr(g.alt, lang)} widths={[360, 600]} sizes="(max-width: 600px) 50vw, 33vw" />
          ))}
        </section>
      )
    }

    {
      i.partners && (
        <section id="partners" class="section">
          <div class="container">
            <div class="section-head">
              <h2>{t('initiative.partners')}</h2>
              <p>{tr(i.partners.text, lang)}</p>
            </div>
            <Partners partners={i.partners.list} lang={lang} />
          </div>
        </section>
      )
    }

    <section id="donate" class="section section--tint">
      <div class="container">
        <DonatePanel initiative={i} lang={lang} />
      </div>
    </section>
  </div>

  {
    others.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{t('initiative.other')}</h2>
          </div>
          <div class="grid grid--2">
            {others.map((o) => (
              <InitiativeCard initiative={o} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .hero {
    padding: clamp(40px, 7vw, 88px) 0 clamp(48px, 7vw, 96px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    margin-bottom: 0.15em;
  }
  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--pink-600);
  }
  .intro {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin-bottom: 30px;
  }
  .hero-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .source {
    margin-top: 24px;
    font-size: 0.85rem;
    color: #8fb0b5;
  }
  .charts {
    margin-top: 32px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
